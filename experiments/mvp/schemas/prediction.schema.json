{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepfake-standard.local/schemas/prediction.schema.json",
  "title": "Unified Deepfake Prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "system_id", "system_version", "run_id", "is_fake_pred", "fake_score", "processing_time_sec", "status", "error_code", "schema_version"],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^DFSTD-[A-Z]+-[0-9]{6}$"},
    "system_id": {"type": "string", "minLength": 1},
    "system_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "is_fake_pred": {"type": ["boolean", "null"]},
    "fake_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "processing_time_sec": {"type": ["number", "null"], "minimum": 0},
    "status": {"enum": ["ok", "unsupported", "invalid_input", "runtime_error", "timeout", "missing_output", "not_applicable"]},
    "error_code": {"type": ["string", "null"]},
    "fake_modality_pred": {"type": "array", "items": {"enum": ["M1", "M2", "M3", "M4", "M5"]}, "uniqueItems": true},
    "fake_object_pred": {"type": "array", "items": {"enum": ["O1", "O2", "O3", "O4"]}, "uniqueItems": true},
    "segments": {"type": "array", "items": {"type": "object"}},
    "regions": {"type": "array", "items": {"type": "object"}},
    "evidence_files": {"type": "array", "items": {"type": "string"}},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}, "required": ["status"]},
      "then": {
        "properties": {
          "is_fake_pred": {"type": "boolean"},
          "fake_score": {"type": "number", "minimum": 0, "maximum": 1},
          "processing_time_sec": {"type": "number", "minimum": 0},
          "error_code": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["runtime_error", "timeout", "missing_output"]}}, "required": ["status"]},
      "then": {"properties": {"error_code": {"type": "string", "minLength": 1}}}
    }
  ]
}
